# SplitSnap Backend Configuration

# Server settings
HOST=0.0.0.0
PORT=8000
DEBUG=True

# Allowed CORS Origins (comma separated)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173,http://localhost:8080,http://127.0.0.1:3000,http://127.0.0.1:5173,http://127.0.0.1:8080

# Optional: Vision AI OCR Keys (if you have Gemini or OpenAI API key, paste here for ultra-accurate AI OCR)
